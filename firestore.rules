rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // events/{eventId}: title, electionTitle, status, createdAt, updatedAt
    // participants: name, church, SHA-256 lookupKeyHash, eligibility/check-in/vote state, staff audit fields
    // candidates: name, order, active, createdAt
    // tallies: aggregate count only; voteReceipts: proof of one-time use only
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'cbroker@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isParticipant(eventId) {
      return isSignedIn()
        && request.auth.token.eventId == eventId
        && request.auth.token.participantId is string;
    }

    function isOwnParticipant(eventId, participantId) {
      return isParticipant(eventId)
        && request.auth.token.participantId == participantId;
    }

    function validEvent(data) {
      return data.keys().hasOnly(['title', 'electionTitle', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'electionTitle', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.electionTitle is string && data.electionTitle.size() >= 1 && data.electionTitle.size() <= 150
        && data.status in ['checkin', 'voting', 'closed', 'results']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validParticipant(data) {
      return data.keys().hasOnly(['name', 'church', 'lookupKeyHash', 'eligible', 'checkedInAt', 'checkInMethod', 'checkedInByUid', 'hasVoted', 'createdAt', 'updatedAt', 'lastAuthUid', 'votedAt'])
        && data.keys().hasAll(['name', 'church', 'lookupKeyHash', 'eligible', 'checkedInAt', 'hasVoted', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.church is string && data.church.size() >= 1 && data.church.size() <= 100
        && data.lookupKeyHash is string && data.lookupKeyHash.matches('^[a-f0-9]{64}$')
        && data.eligible is bool
        && (data.checkedInAt == null || data.checkedInAt is timestamp)
        && (data.checkedInAt == null || ('checkInMethod' in data && data.checkInMethod in ['self', 'staff']))
        && (!('checkInMethod' in data) || data.checkInMethod in ['self', 'staff'])
        && (!('checkedInByUid' in data) || (data.checkedInByUid is string && data.checkedInByUid.size() >= 1 && data.checkedInByUid.size() <= 128))
        && (!('checkInMethod' in data) || data.checkInMethod != 'staff' || 'checkedInByUid' in data)
        && data.hasVoted is bool
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('lastAuthUid' in data) || (data.lastAuthUid is string && data.lastAuthUid.size() <= 128))
        && (!('votedAt' in data) || data.votedAt is timestamp);
    }

    function validCandidate(data) {
      return data.keys().hasOnly(['name', 'order', 'active', 'createdAt'])
        && data.keys().hasAll(['name', 'order', 'active', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.order is int && data.order >= 0 && data.order <= 500
        && data.active is bool
        && data.createdAt is timestamp;
    }

    match /events/{eventId} {
      allow read: if isBootstrapAdmin() || isParticipant(eventId);
      allow create: if isBootstrapAdmin() && validEvent(request.resource.data);
      allow update: if isBootstrapAdmin()
        && validEvent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if isBootstrapAdmin() || isOwnParticipant(eventId, participantId);
        allow create: if isBootstrapAdmin() && validParticipant(request.resource.data);
        allow update: if isBootstrapAdmin()
          && validParticipant(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.lookupKeyHash == resource.data.lookupKeyHash;
        allow delete: if isBootstrapAdmin();
      }

      match /candidates/{candidateId} {
        allow read: if isBootstrapAdmin() || isParticipant(eventId);
        allow create: if isBootstrapAdmin() && validCandidate(request.resource.data);
        allow update: if isBootstrapAdmin()
          && validCandidate(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isBootstrapAdmin();
      }

      match /tallies/{candidateId} {
        allow read: if isBootstrapAdmin()
          || (isParticipant(eventId) && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'results');
        allow write: if false;
      }

      match /voteReceipts/{participantId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Legacy apps retained for compatibility and isolated from event voting.
    match /wordcloud_words/{document} {
      allow read, write: if true;
    }
    match /scout_trips/{trip}/{document=**} {
      allow read, write: if true;
    }
    match /posts/{doc} {
      allow read, write: if true;
    }
    match /config/{doc} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
